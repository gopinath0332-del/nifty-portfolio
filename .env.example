# ============================================================
# Nifty Portfolio Engine — Environment Configuration (.env)
# ============================================================

# Path to shared .env file in nifty-strike-engine (where daily auto_login refreshes KITE_ACCESS_TOKEN)
# Windows: D:\Workspace\nifty-strike-engine\.env
# Raspberry Pi: /home/pi/nifty-strike-engine/.env
KITE_ENV_PATH=D:\Workspace\nifty-strike-engine\.env

# Alternatively, set Kite credentials directly here if running standalone:
KITE_API_KEY=
KITE_ACCESS_TOKEN=

# Discord Webhook for Buy/Sell Signals, Daily Portfolio Summary & Alerts
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/1568208979576881263/RNJYGAZe-jGwxTpBHmQDFTuOlzOx6SSUr22dh9yZhzlFhstdHL-gal4TjEbmwgt7dZ6w

# Live Order Placement Safety Flag:
# false: Paper trading / Manual execution via Discord alerts (Default)
# true: Automatically send CNC market orders to Zerodha exchange
LIVE_ORDER_PLACEMENT=false

